{
  "manifest_version": 3,
  "name": "RakuTube",
  "version": "1.2.1",
  "permissions": ["storage"],
  "host_permissions": ["https://y2down.cc/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "128": "icon.png" },
  "action": { "default_title": "設定", "default_popup": "settings.html", "default_icon": "icon.png" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["shared.js", "tooltip.js", "youtube.js"],
      "css": ["youtube.css"]
    },
    {
      "matches": ["https://y2down.cc/jaWa/*"],
      "js": ["shared.js", "y2down.js"]
    }
  ]
}
